# Secret used to sign the session cookie. Generate with: openssl rand -hex 32
# Optional in development (a dev-only fallback is used). Set it in production.
SESSION_SECRET=

# Gemini on Vertex AI (leaf extraction). No API key: auth is Application Default Credentials
# (locally `gcloud auth application-default login`, on Cloud Run the service account).
# Without GOOGLE_CLOUD_PROJECT the app runs on the committed cached responses only.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-east1
GEMINI_MODEL=gemini-3.5-flash
# Tried when GEMINI_MODEL fails (quota, outage), before the cached responses.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# Optional: timeout per call (ms, default 15000); GEMINI_PREFER_CACHE=1 answers from the cache first (identical demo takes).
GEMINI_TIMEOUT_MS=
GEMINI_PREFER_CACHE=
